    "test": "node scripts/test.js --transformIgnorePatterns \"node_modules/(?!geodesy)/\"",
    "lint": "CI=true eslint src",
    "stylelint": "node ./node_modules/stylelint/bin/stylelint.js ./src/**/*.scss",
    "test-ci": "CI=true node scripts/test.js --silent --detectOpenHandles --forceExit --transformIgnorePatterns \"node_modules/(?!geodesy)/\"",
