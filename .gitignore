# Dependencies
/node_modules

# Yarn: keep the pinned release and its config, ignore the cache and install state
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/sdks
!/.yarn/versions

# Build and test output
/build
/coverage

# Local environment and runtime config
*.local
/public/config.js

# Editors and tools
.DS_Store
/.idea
/.vscode
/.claude/settings.local.json
